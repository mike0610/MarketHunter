# MarketHunter - runs outcome-intelligence-weekly.service once a week,
# Monday 06:30 UTC (after the daily cycle). UTC is specified explicitly
# so the schedule does not depend on the server's local timezone
# setting.

[Unit]
Description=Run MarketHunter Outcome Intelligence weekly cycle once a week

[Timer]
OnCalendar=Mon *-*-* 06:30:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
