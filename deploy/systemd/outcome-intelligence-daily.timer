# MarketHunter - runs outcome-intelligence-daily.service once a day
# at 06:00 UTC. UTC is specified explicitly so the schedule does not
# depend on the server's local timezone setting.

[Unit]
Description=Run MarketHunter Outcome Intelligence daily cycle once a day

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
