[Unit]
Description=MarketHunter SL crypto scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/MarketHunter
EnvironmentFile=-/home/ubuntu/MarketHunter/deploy/systemd/sl-crypto-scanner.env
ExecStart=/home/ubuntu/MarketHunter/.venv/bin/python -m tools.sl_crypto_scanner_runtime.runtime
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
