# MarketHunter Outcome Intelligence runtime - environment file example.
#
# Copy this to /home/ubuntu/MarketHunter/deploy/systemd/outcome-intelligence.env
# (matching EnvironmentFile= in the .service units - this path is
# git-ignored, see .gitignore), fill in real values, and restrict its
# permissions: `chown ubuntu:ubuntu` + `chmod 600`, so only the
# service user can read it. Never commit a filled-in copy of this file.

# Required for the daily cycle only (it performs the capture). The
# weekly cycle only reads already-captured history and does not need
# this variable.
OUTCOME_INTELLIGENCE_API_BASE_URL=http://127.0.0.1:8000

# Required for both cycles - a Slack "Incoming Webhook" URL for the
# channel Outcome Intelligence reports should post to. If an approved
# Slack webhook/secret already exists for this MarketHunter deployment,
# reuse its value here rather than creating a new one.
OUTCOME_INTELLIGENCE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/ME/WITH_REAL_WEBHOOK

# Optional - defaults to data/outcome_intelligence relative to
# WorkingDirectory= if unset.
#OUTCOME_INTELLIGENCE_OUTPUT_DIR=/home/ubuntu/MarketHunter/data/outcome_intelligence
