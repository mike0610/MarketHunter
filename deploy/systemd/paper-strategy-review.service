[Unit]
Description=MarketHunter paper strategy auto-review
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/MarketHunter
EnvironmentFile=-/home/ubuntu/MarketHunter/deploy/systemd/paper-strategy-review.env
ExecStart=/home/ubuntu/MarketHunter/.venv/bin/python -m tools.paper_strategy_review_runtime.runtime
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
