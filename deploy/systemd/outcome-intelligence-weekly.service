# MarketHunter - Outcome Intelligence weekly cycle. Does NOT capture -
# reads history captured by outcome-intelligence-daily.service, so it
# needs no API base URL, only the Slack webhook.
# Triggered by outcome-intelligence-weekly.timer - not enabled directly.
#
# EXAMPLE paths/user below (markethunter / /opt/markethunter). Adjust
# to match the real deployment layout - see deploy/systemd/README.md
# before installing.

[Unit]
Description=MarketHunter Outcome Intelligence - weekly persistence report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=markethunter
WorkingDirectory=/opt/markethunter
EnvironmentFile=/opt/markethunter/deploy/outcome-intelligence.env
ExecStart=/opt/markethunter/.venv/bin/python -m tools.outcome_intelligence.runtime weekly

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
