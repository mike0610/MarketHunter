[Unit]
Description=MarketHunter isolated manual scanner (simulation-free, local-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/markethunter-manual-scanner-v1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=STANDALONE_SCANNER_DB=/home/ubuntu/markethunter-manual-scanner-state/standalone_scanner.db
ExecStart=/home/ubuntu/MarketHunter/.venv/bin/python -m uvicorn services.standalone_scanner:app --host 127.0.0.1 --port 8010 --workers 1 --no-access-log
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/home/ubuntu/markethunter-manual-scanner-state
MemoryMax=1200M
TasksMax=100

[Install]
WantedBy=multi-user.target
